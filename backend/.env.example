# ─────────────────────────────────────────────────────────────
# MaanSetu backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
# Bind to all interfaces so the container/sandbox preview can reach it.
HOST=0.0.0.0

# ── Authentication ──────────────────────────────────────────
# MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Set COOKIE_SECURE=true only when the site is served over HTTPS; a Secure
# cookie is never sent over plain HTTP, which would silently log everyone out.
COOKIE_SECURE=false
# 'lax' keeps the session working across top-level navigation.
COOKIE_SAME_SITE=lax

# ── CORS ────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API with credentials.
# Must match the Vite dev server port and any deployed frontend origin.
# An entry starting with a dot matches any subdomain, e.g. `.e2b.app` covers a
# generated preview tunnel such as https://3000-abc123.e2b.app.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,.e2b.app

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maansetu
DB_USER=postgres
DB_PASSWORD=postgres

# ── Certificates ────────────────────────────────────────────
# Base URL written into every certificate QR code. Point this at the public
# verification page, not at the API.
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
