{
  "name": "maansetu-backend",
  "version": "1.0.0",
  "description": "Legal Metrology verification portal — REST API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:db": "node scripts/devDatabase.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:reset": "npm run db:setup && npm run db:seed",
    "test": "node --test 'test/**/*.test.js'",
    "check": "node scripts/checkWiring.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
